# Copy to backend/.env. Everything is optional in dev.
ENV=dev                      # dev | prod
SECRET_KEY=                  # REQUIRED in prod: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=                # default sqlite in backend/; prod: postgresql+psycopg://user:pass@host/db
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173/api   # the PUBLIC address of the API (in prod: https://yourdomain.com/api)
COOKIE_PATH_PREFIX=/api       # where the API is mounted on the public site; use empty if it is served at the root
TRUST_PROXY=0                 # set 1 only when the API sits behind your own nginx/Cloudflare (needed for correct rate limits)
COOKIE_SECURE=                # blank = automatic (on in prod)
COOKIE_DOMAIN=
ADMIN_EMAILS=                # comma list: who can see pilot requests
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=

# Google sign-in: console.cloud.google.com -> Credentials -> OAuth client (Web).
# Authorised redirect URI: {API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Business Cloud API (Meta). Needs an approved AUTHENTICATION template (one {{1}} code + copy-code button)
# and a UTILITY template for approval alerts (two params: message, link).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=reschedule_otp
WHATSAPP_NOTIFY_TEMPLATE=reschedule_approval

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ReSchedule <no-reply@yourdomain.com>

# Cloudflare Turnstile (optional CAPTCHA on the pilot form)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# dev only: show one-time codes in the API response and the dev outbox. Forced off in prod unless set.
DEV_ECHO_OTP=1

# --- DuckMama (live assistant, Google Gemini) ---
LLM_PROVIDER=gemini        # empty = assistant disabled
LLM_API_KEY=               # Google AI Studio / Gemini key. Never commit it.
GEMINI_MODEL=gemini-flash-lite-latest
# BENCHMARK_PATH=          # where benchmark.json lives (docker mounts it)
# ASSISTANT_PER_MIN=12
# ASSISTANT_PER_DAY=300

# One-click judge workspace (POST /auth/demo). On by default in dev, OFF in prod unless you set 1.
# It creates a private, auto-deleted (24 h) sample shop per visitor. Turn it off for real customers.
DEMO_LOGIN=1
