# Copy to backend/.env.prod on the server. Never commit it. Generate SECRET_KEY with:  openssl rand -hex 32
# ENV, DATABASE_URL, TRUST_PROXY and COOKIE_PATH_PREFIX are set by docker-compose.yml.
SECRET_KEY=
ALLOWED_ORIGINS=https://reschedule.example.com
PUBLIC_APP_URL=https://reschedule.example.com
API_PUBLIC_URL=https://reschedule.example.com/api

# Staff access: a verified account with this email sees the pilot requests
ADMIN_EMAILS=you@example.com
ADMIN_NOTIFY_EMAIL=you@example.com
ADMIN_NOTIFY_PHONE=+91XXXXXXXXXX

# DuckMama (use a paid Gemini key for real customer data)
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Email codes and alerts (any SMTP account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ReSchedule <you@example.com>

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Do NOT set DEV_ECHO_OTP in production.

# Judge demo button. Leave at 0 for real customers; set 1 only while presenting.
DEMO_LOGIN=0
